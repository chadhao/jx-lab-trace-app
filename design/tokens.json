{
  "$schema": "jx-lab-trace-app design tokens",
  "version": "0.1.0-draft",
  "note": "唯一真相：Compose 主题、原型 CSS、设计文档三处均由此文件生成/比对，禁止在别处硬编码颜色与字号。",
  "meta": {
    "app_name_zh": "江熙追溯",
    "app_name_en": "JX Lab Trace",
    "package": "cn.hunanjiangxi.jxlabtrace",
    "baseline": "竖屏手机 390x844dp / 411dp 宽，向下兼容 360dp（4 寸 PDA）",
    "theme": "light-only，车间强光下高对比",
    "accessibility": "WCAG AA 正文 >=4.5:1，大字 >=3:1，触控目标 >=56dp"
  },
  "color": {
    "brand": {
      "primary": "#0B4F9E",
      "primaryPressed": "#083B76",
      "primarySoft": "#E8F0FB",
      "onPrimary": "#FFFFFF"
    },
    "domain": {
      "receiving": { "base": "#1D4ED8", "soft": "#E7EDFC", "on": "#FFFFFF", "label": "收货 / 到货" },
      "production": { "base": "#B54708", "soft": "#FDF0E4", "on": "#FFFFFF", "label": "生产 / 投料" },
      "qc": { "base": "#067647", "soft": "#E4F4EC", "on": "#FFFFFF", "label": "取样 / 化验" },
      "shipment": { "base": "#0E7490", "soft": "#E2F1F5", "on": "#FFFFFF", "label": "出货 / 出场" },
      "trace": { "base": "#6D28D9", "soft": "#EFE9FD", "on": "#FFFFFF", "label": "追溯 / 查询" }
    },
    "status": {
      "success": "#067647",
      "successSoft": "#E4F4EC",
      "warning": "#B54708",
      "warningSoft": "#FDF0E4",
      "danger": "#B42318",
      "dangerSoft": "#FDECEA",
      "info": "#0B4F9E",
      "infoSoft": "#E8F0FB",
      "neutral": "#475467",
      "neutralSoft": "#F2F4F7"
    },
    "text": {
      "primary": "#101828",
      "secondary": "#475467",
      "tertiary": "#667085",
      "inverse": "#FFFFFF",
      "disabled": "#98A2B3"
    },
    "surface": {
      "canvas": "#F2F4F7",
      "card": "#FFFFFF",
      "sunken": "#F9FAFB",
      "border": "#D0D5DD",
      "borderStrong": "#98A2B3",
      "scrim": "rgba(16,24,40,0.45)"
    }
  },
  "typography": {
    "family": {
      "sans": "system-ui, -apple-system, 'Noto Sans SC', 'Source Han Sans SC', 'Microsoft YaHei', sans-serif",
      "mono": "'JetBrains Mono', 'Roboto Mono', ui-monospace, monospace"
    },
    "scale": {
      "display": { "size": 34, "lineHeight": 40, "weight": 700, "usage": "扫码成功回显、过磅读数" },
      "h1": { "size": 26, "lineHeight": 32, "weight": 700, "usage": "页面主标题、入口卡主数字" },
      "h2": { "size": 20, "lineHeight": 26, "weight": 700, "usage": "区块标题、入口卡标题" },
      "h3": { "size": 17, "lineHeight": 24, "weight": 600, "usage": "卡片标题、列表主行" },
      "body": { "size": 15, "lineHeight": 22, "weight": 400, "usage": "正文、表单值（下限，不得更小）" },
      "bodyStrong": { "size": 15, "lineHeight": 22, "weight": 600, "usage": "强调正文" },
      "label": { "size": 13, "lineHeight": 18, "weight": 500, "usage": "字段标签、辅助说明（仅次要信息）" },
      "code": { "size": 15, "lineHeight": 22, "weight": 600, "usage": "追踪码人读行（等宽，字距 +0.5）" }
    }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "radius": { "sm": 8, "md": 12, "lg": 16, "pill": 999 },
  "size": {
    "touchMin": 56,
    "touchComfort": 64,
    "primaryButton": 60,
    "iconSm": 20,
    "iconMd": 24,
    "iconLg": 32,
    "entryIcon": 44,
    "tabbar": 64,
    "traceScanHero": 120,
    "topbar": 56
  },
  "elevation": {
    "none": "none",
    "card": "0 1px 2px rgba(16,24,40,0.06)",
    "sheet": "0 -8px 32px rgba(16,24,40,0.16)",
    "float": "0 6px 20px rgba(16,24,40,0.18)"
  },
  "motion": {
    "fast": 120,
    "normal": 220,
    "sheet": 280,
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "feedback": {
    "scanSuccess": "短震动 40ms + 双音蜂鸣 + 全屏绿边闪一次 + 大字号回显 6 位尾码",
    "scanFail": "长震动 200ms + 单低音 + 红边闪 + 原因文字（非仅颜色）",
    "submitSuccess": "绿勾 + 触觉反馈 + 自动返回上一页（1.2s）",
    "networkDown": "顶部红色常驻条 + 提交按钮置灰并标注『网络中断』，表单内容保留"
  }
}
